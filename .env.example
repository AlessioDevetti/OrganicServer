# ==================================================================
# OrganicServer — esempio di variabili d'ambiente
#
# Copiare questo file in `.env` e popolare i valori sul server.
# Il file `.env` è ignorato da Git e non deve mai essere committato.
# Nessun valore reale, credenziale o chiave va inserito qui.
# ==================================================================

# Dominio pubblico servito dal reverse proxy (senza schema, senza slash).
DOMAIN=

# Fuso orario IANA del server, usato da container e log (es. Europe/Rome).
TZ=

# Prefisso IPv6 delegato al server, in notazione CIDR.
# Esempio di documentazione (RFC 3849): 2001:db8::/64
# Usare esclusivamente il prefisso realmente assegnato dal provider.
IPV6_PREFIX=

# Subnet IPv4 (RFC 1918) della rete Docker esposta `edge`.
IPV4_EDGE_SUBNET=172.20.0.0/24

# Subnet IPv4 (RFC 1918) della rete Docker interna `internal`.
IPV4_INTERNAL_SUBNET=172.30.0.0/24

# Nome della rete Docker condivisa dagli stack.
DOCKER_NETWORK=

# UID/GID dell'utente che possiede i volumi persistenti.
PUID=1000
PGID=1000

# Email di contatto per l'account ACME del reverse proxy.
ACME_EMAIL=
